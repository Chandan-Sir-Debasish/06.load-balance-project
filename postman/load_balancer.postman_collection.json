{
	"info": {
		"_postman_id": "8f8b8a8e-cfbe-4299-a9a3-cce393ff80e1",
		"name": "Nginx Load Balancer Collection",
		"description": "API requests to test the Task Manager Backend (routed through Nginx load balancer) and the Load Balancer Management API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Task API",
			"item": [
				{
					"name": "Get Tasks",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains server node and task list\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('tasks');",
									"    pm.expect(jsonData).to.have.property('server');",
									"    console.log(\"Request served by Nginx upstream node: \" + jsonData.server);",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/tasks",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tasks"
							]
						},
						"description": "Fetch list of tasks from the backend cluster. Nginx will distribute this request to backend-1, backend-2, or backend-3 depending on the active balancing algorithm."
					},
					"response": []
				},
				{
					"name": "Create Task",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Extract and store task ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('task');",
									"    pm.expect(jsonData.task).to.have.property('_id');",
									"    pm.environment.set(\"lastTaskId\", jsonData.task._id);",
									"    console.log(\"Saved lastTaskId: \" + jsonData.task._id);",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Postman Integration Task #{{$randomInt}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tasks",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tasks"
							]
						},
						"description": "Create a new task. The request goes to a distributed backend node, which stores it in MongoDB and flags the creation source with its host identifier."
					},
					"response": []
				},
				{
					"name": "Delete Task",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/tasks/{{lastTaskId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tasks",
								"{{lastTaskId}}"
							]
						},
						"description": "Delete the recently created task using the dynamic variable set by the Create Task test."
					},
					"response": []
				}
			]
		},
